# Vulniverse standalone-app configuration.
#
# Copy this file to vulniverse.toml (untracked, gitignored) and edit it for
# your deployment. If vulniverse.toml is absent, the backend falls back to
# this sample file's values, so a fresh checkout behaves exactly like a
# deployment with no config file at all — nothing here is required.

[panels.stats]
enabled = false

[panels.vl]
enabled = false

[panels.cve-program]
enabled = false

[panels.record-quality]
enabled = true

# Opt-in only: needed by hosts with GCVE-only storage (e.g.
# Vulnerability-Lookup), not by the standalone app.
[panels.gcve-identifier]
enabled = false

[panels.patch2vuln]
enabled = true
# patch2vuln executable/script.
executable = "/opt/patch2vuln/patch2vuln.py"
# Ollama may run on another machine in the local network.
ollama_host = "http://ollama.internal:11434"
model = "qwen3.8:27b"
timeout_seconds = 300


[actions]
# Which header-button actions the standalone app shows, keyed by
# EditorAction.id.
"download-json" = true
