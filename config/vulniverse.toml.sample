# Vulniverse standalone-app configuration.
#
# Copy this file to vulniverse.toml (untracked, gitignored) and edit it for
# your deployment. If vulniverse.toml is absent, the backend falls back to
# this sample file's values, so a fresh checkout behaves exactly like a
# deployment with no config file at all — nothing here is required.

[server]
mode = "local" # local or multiuser -> Mulituser still WIP (do not use in prod)
# Multi-user mode only: who may create an account. "open" (anyone),
# "invite" (only with an organisation's invitation link) or "closed".
registration = "open"
# Multi-user mode only: every account must set up two-factor
# authentication (an authenticator app code at every login).
two_factor = false

[features]
# Vendor/product autocomplete, backed by the local CPE catalog (see
# `flask cpe sync`) — no outbound requests at search time either way.
cpeVendors = true
cpeProducts = true
# Full CPE-identifier suggestions. Left here for documentation, but
# there is currently no local catalog to serve it from, so this has
# no effect yet regardless of what it's set to.
cpeEntries = false
# CWE/CAPEC autocomplete. Each lookup that reaches the backend (not
# just the UI) is disabled when set to false — see reference_data.py.
cwe = true
capec = true

[panels.stats]
enabled = false

[panels.vl]
enabled = false
# The servers users may publish to; each user picks one of these for
# their CNA credentials. Only listed servers are ever contacted.
# [[panels.vl.instances]]
# id = "circl"
# name = "CIRCL Vulnerability-Lookup"
# api_url = "https://vulnerability.circl.lu/api/cna"

[panels.cve-program]
enabled = false
# [[panels.cve-program.instances]]
# id = "cve"
# name = "CVE Program"
# api_url = "https://cveawg.mitre.org/api"

[panels.record-quality]
enabled = true

[panels.patch2vuln]
enabled = true
# Base URL of a patch2vuln web service instance (the Flask app in
# gcve-eu/gcve-lab-patch2vuln's main branch, not the CLI tool) — see
# its docs/web-service.md for the full API.
api_url = "https://patch2vuln.example.org"
# Bearer token, only required if the service was started with
# PATCH2VULN_API_TOKEN set. Prefer the PATCH2VULN_API_TOKEN env var
# over committing a real token here.
# api_token = ""
# Optional: up to 4 model names to request: defaults to whatever the
# service itself is configured to use.
# models = ["qwen3.8:27b"]
timeout_seconds = 300


[actions]
# Which header-button actions the standalone app shows, keyed by
# EditorAction.id.
"download" = true
"tutorial" = true
