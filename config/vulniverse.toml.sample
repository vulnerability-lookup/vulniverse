# Vulniverse standalone-app configuration.
#
# Copy this file to vulniverse.toml (untracked, gitignored) and edit it for
# your deployment. If vulniverse.toml is absent, the backend falls back to
# this sample file's values, so a fresh checkout behaves exactly like a
# deployment with no config file at all — nothing here is required.

[server]
mode = "local" # local or multiuser -> Mulituser still WIP (do not use in prod)

[features]
# Vendor/product autocomplete, backed by the local CPE catalog (see
# `flask cpe sync`) — no outbound requests at search time either way.
cpeVendors = true
cpeProducts = true
# Full CPE-identifier suggestions. Left here for documentation, but
# there is currently no local catalog to serve it from, so this has
# no effect yet regardless of what it's set to.
cpeEntries = false
# CWE/CAPEC autocomplete. Each lookup that reaches the backend (not
# just the UI) is disabled when set to false — see reference_data.py.
cwe = true
capec = true

[panels.stats]
enabled = false

[panels.vl]
enabled = false

[panels.cve-program]
enabled = false

[panels.record-quality]
enabled = true

[panels.patch2vuln]
enabled = true
# patch2vuln executable/script.
executable = "/opt/patch2vuln/patch2vuln.py"
ollama_host = "http://host.docker.internal:11434"
model = "qwen3.8:27b"
timeout_seconds = 300


[actions]
# Which header-button actions the standalone app shows, keyed by
# EditorAction.id.
"download-json" = true
