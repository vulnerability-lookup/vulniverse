# Example systemd unit for running the Vulniverse backend under gunicorn.
# See docs/setup/production.md for the full walkthrough. Copy this to
# /etc/systemd/system/vulniverse.service and adjust the paths/user below
# for your deployment, then:
#
#   systemctl daemon-reload
#   systemctl enable --now vulniverse

[Unit]
Description=Vulniverse backend
After=network.target

[Service]
# A dedicated, unprivileged user — never run this as root.
User=vulniverse
Group=vulniverse

WorkingDirectory=/opt/vulniverse/backend

# Replace with actual generated values — see docs/setup/production.md.
Environment=SECRET_KEY=replace-with-a-real-generated-secret
Environment=CNA_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-real-generated-fernet-key

# Runs on every start and restart, with the same User/WorkingDirectory/
# Environment as ExecStart below — safe to repeat, since "db upgrade" is
# a no-op once already at the latest revision.
ExecStartPre=/opt/vulniverse/backend/.venv/bin/flask --app vulniverse_api db upgrade

ExecStart=/opt/vulniverse/backend/.venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8000 \
    wsgi:app

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
