# Copy to .env and fill in real values 

# Required. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Required. Encrypts per-user CNA credentials at rest. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Changing this after credentials have been saved makes them undecryptable.
CNA_CREDENTIAL_ENCRYPTION_KEY=

# Optional — defaults to the SQLite file in Flask's instance folder
# (backend/src/instance/vulniverse.sqlite) if unset.
# DATABASE_URL=postgresql://user:password@host:5432/vulniverse
